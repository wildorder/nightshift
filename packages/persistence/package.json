{
  "name": "@nightshift/persistence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Persistence adapters. ./memory is test-only; ./aws is DynamoDB and S3; ./http is the control-plane API.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "default": "./dist/aws/index.js"
    },
    "./aws/testing": {
      "types": "./dist/aws/testing/index.d.ts",
      "default": "./dist/aws/testing/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./http/browser": {
      "types": "./dist/http/browser/index.d.ts",
      "default": "./dist/http/browser/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "default": "./dist/local/index.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@nightshift/contracts": "*",
    "@nightshift/core": "*",
    "zod": "4.6.4"
  }
}
