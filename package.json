{
  "name": "nightshift",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous engineering control plane: controlled delegation, deterministic verification, model routing, and reversible decisions for frontier coding agents.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/*",
    "test"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @nightshift/studio",
    "build:clean": "tsc -b --clean && tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json && npm run typecheck --workspace @nightshift/studio",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "synth": "npm run build && npm --workspace @nightshift/cdk run synth",
    "check:sterility": "node scripts/check-sterility.mjs",
    "check:architecture": "vitest run --project test",
    "deploy": "node scripts/deploy.mjs",
    "smoke": "node scripts/smoke.mjs",
    "studio:smoke": "node scripts/studio-smoke.mjs",
    "slice": "node scripts/slice.mjs",
    "conformance": "node scripts/conformance.mjs",
    "routing": "node scripts/routing.mjs",
    "correction": "node scripts/correction.mjs",
    "benchmark:parallel": "npm run build && vitest run test/src/parallel/benchmark.test.ts",
    "admin:user": "node scripts/admin-user.mjs",
    "image:build": "node scripts/image-build.mjs",
    "runner:boot": "node scripts/runner-boot.mjs",
    "remote": "node scripts/remote.mjs",
    "verify": "npm run build && npm run typecheck && npm run lint && npm test && npm run synth && npm run check:sterility",
    "studio": "npm run dev --workspace @nightshift/studio",
    "local:e2e": "npm run build && vitest run --project test src/local"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.19.0",
    "aws-cdk": "2.1141.0",
    "fast-check": "4.10.0",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildorder/nightshift.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/wildorder/nightshift/issues"
  },
  "homepage": "https://github.com/wildorder/nightshift#readme"
}
