{
  "name": "@nightshift/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Control-plane HTTP runtime.",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "source": "./src/testing/local-control-plane.ts",
      "types": "./dist/testing/local-control-plane.d.ts",
      "default": "./dist/testing/local-control-plane.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1131.0",
    "@aws-sdk/client-kms": "3.1131.0",
    "@aws-sdk/client-lambda": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-secrets-manager": "3.1131.0",
    "@aws-sdk/client-ssm": "3.1131.0",
    "@nightshift/contracts": "*",
    "@nightshift/core": "*",
    "@nightshift/persistence": "*",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1131.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1131.0",
    "@aws-sdk/client-sts": "3.1131.0",
    "@nightshift/test": "*",
    "@types/aws-lambda": "8.10.163"
  },
  "bin": {
    "nightshift-local": "./dist/bin/nightshift-local.js"
  },
  "license": "Apache-2.0"
}
